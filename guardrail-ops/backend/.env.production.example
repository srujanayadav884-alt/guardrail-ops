# ============================================================
# GuardRail-Ops — PRODUCTION environment template
# Copy to `.env` on the production host/secret store and fill
# in real values. Never commit a filled-in copy of this file.
# ============================================================

NODE_ENV=production

PORT=4000
# Exact origin(s) of your deployed frontend — no wildcards, no trailing slash
CORS_ORIGIN=https://your-guardbank-domain.example

# ---- PostgreSQL (managed instance recommended in production) ----
DB_HOST=your-db-host.example
DB_PORT=5432
DB_USER=guardrail_ops_app
DB_PASSWORD=use_a_secrets_manager_not_this_file
DB_NAME=guardrail_ops
DB_SSL=true
DATABASE_URL=postgresql://guardrail_ops_app:REPLACE_ME@your-db-host.example:5432/guardrail_ops?sslmode=require

# ---- Auth / JWT ----
# Generate with: openssl rand -base64 48 — store in a secrets manager, not source control
JWT_SECRET=REPLACE_ME_WITH_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=1h
JWT_ISSUER=guardrail-ops
JWT_AUDIENCE=guardbank-clients

# ---- Gemini API ----
# Store in a secrets manager (AWS Secrets Manager, GCP Secret Manager, Doppler, etc.)
# and inject at deploy time — never bake into an image or commit to source control.
GROQ_API_KEY=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
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Rate limiting (tune to expected production traffic) ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=10

# ---- Logging ----
LOG_LEVEL=info
