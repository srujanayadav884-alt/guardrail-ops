# ---- Runtime ----
NODE_ENV=development

# ---- Server ----
PORT=4000
# Comma-separated list of allowed origins (no trailing slash), e.g.:
# CORS_ORIGIN=http://localhost:5173,https://app.guardbank.example
CORS_ORIGIN=http://localhost:5173

# ---- PostgreSQL ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=guardrail_ops
# Set to "true" to require SSL to Postgres in production (e.g. managed DB providers)
DB_SSL=false
# Used by npm run db:schema / db:seed / db:migrate (psql connection string form)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/guardrail_ops

# ---- Auth / JWT ----
# Generate a strong random value, e.g.: openssl rand -base64 48
# Must be at least 32 characters — the server refuses to start in production without one.
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=2h
JWT_ISSUER=guardrail-ops
JWT_AUDIENCE=guardbank-clients

# ---- Gemini API ----
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# ---- Logging ----
# trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# ---- Seeding ----
# Password assigned to admin@guardbank.com, security@guardbank.com, and demo@guardbank.com
# when running `npm run seed:users`. Change this and rotate the accounts before any real use.
SEED_DEFAULT_PASSWORD=ChangeMe123!
